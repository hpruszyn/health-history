---
import "@fontsource-variable/instrument-sans";
import "@fontsource-variable/newsreader";
import "../styles/global.css";

interface Props {
  lang: "pl" | "en";
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(`${base}${lang}/`, Astro.site);
const otherLang = lang === "pl" ? "en" : "pl";
const alternate = new URL(`${base}${otherLang}/`, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3efe6" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === "pl" ? "pl_PL" : "en_GB"} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={otherLang} href={alternate} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === "pl" ? "Przejdź do treści" : "Skip to content"}</a>
    <slot />
  </body>
</html>
