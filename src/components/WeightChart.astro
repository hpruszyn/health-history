---
import journey from "../../public/data/journey-2025-2026.json";

interface Props { lang: "pl" | "en"; }
const { lang } = Astro.props;
const points = journey.weights;
const locale = lang === "pl" ? "pl-PL" : "en-GB";
const monthYear = new Intl.DateTimeFormat(locale, { month: "long", year: "numeric" });
const dateLong = new Intl.DateTimeFormat(locale, { day: "numeric", month: "long", year: "numeric" });
const range = `${monthYear.format(new Date(`${points[0].date}T12:00:00`))} — ${monthYear.format(new Date(`${points.at(-1)?.date}T12:00:00`))}`;
const snapshotDate = dateLong.format(new Date(`${journey.meta.snapshotDate}T12:00:00`));
const labels = lang === "pl" ? {
  title: `Masa ciała, ${range}`,
  desc: "Każdy zapisany pomiar na rzeczywistej osi czasu oraz siedmiodniowa średnia. Czerwony fragment oznacza wakacyjny wzrost.",
  weight: "Masa", bmi: "BMI", summer: "wakacyjny wzrost", goal: "granica BMI 25",
  note: `${journey.meta.measurementCount} pomiarów do ${snapshotDate}. Najedź, dotknij albo użyj strzałek, aby sprawdzić dowolny dzień. To snapshot trwającej historii, nie zamknięty wynik.`,
  explore: "Interaktywny wykres masy. Użyj strzałek w lewo i w prawo, aby przechodzić między pomiarami."
} : {
  title: `Body weight, ${range}`,
  desc: "Every recorded measurement on its true date and a seven-day average. The red segment marks the summer rebound.",
  weight: "Weight", bmi: "BMI", summer: "summer rebound", goal: "BMI 25 threshold",
  note: `${journey.meta.measurementCount} measurements through ${snapshotDate}. Hover, tap or use the arrow keys to inspect any day. This is a snapshot of an ongoing story, not a final result.`,
  explore: "Interactive weight chart. Use the left and right arrow keys to move through measurements."
};
---

<figure class="chart-shell" data-weight-chart data-height={journey.person.heightCm} data-lang={lang}>
  <figcaption class="chart-heading">
    <div><h3>{labels.title}</h3><p>{labels.desc}</p></div>
    <div class="chart-key" aria-hidden="true">
      <span><i class="key-dot key-dot--raw"></i>{lang === "pl" ? "pomiar" : "measurement"}</span>
      <span><i class="key-line"></i>{lang === "pl" ? "średnia 7 dni" : "7-day average"}</span>
      <span><i class="key-line key-line--rebound"></i>{lang === "pl" ? "regres" : "rebound"}</span>
    </div>
  </figcaption>
  <div class="chart-stage">
    <svg viewBox="0 0 1000 520" role="application" tabindex="0" aria-label={labels.explore}>
      <title>{labels.title}</title><desc>{labels.desc}</desc>
      <g class="chart-grid"></g><g class="chart-goal"></g><g class="chart-paths"></g>
      <g class="chart-points"></g><g class="chart-cursor" aria-hidden="true"></g><g class="chart-axis"></g>
    </svg>
    <div class="chart-tooltip" role="status" aria-live="polite"></div>
  </div>
  <p class="chart-note">{labels.note}</p>
  <script type="application/json" class="chart-data" set:html={JSON.stringify({ points, labels })}></script>
</figure>

<script>
  const NS = "http://www.w3.org/2000/svg";
  const DAY = 86_400_000;
  type WeightPoint = { date: string; kg: number; kind: string; t: number; trend: number };
  type ChartLabels = { weight: string; bmi: string; summer: string; goal: string };
  function svgEl(name: string, attrs: Record<string, string | number> = {}) {
    const el = document.createElementNS(NS, name);
    Object.entries(attrs).forEach(([key, value]) => el.setAttribute(key, String(value)));
    return el;
  }

  document.querySelectorAll<HTMLElement>("[data-weight-chart]").forEach((root) => {
    const svg = root.querySelector<SVGSVGElement>("svg");
    const tooltip = root.querySelector<HTMLElement>(".chart-tooltip");
    const dataNode = root.querySelector<HTMLScriptElement>(".chart-data");
    if (!svg || !tooltip || !dataNode?.textContent) return;
    const raw = JSON.parse(dataNode.textContent) as { points: Omit<WeightPoint, "t" | "trend">[]; labels: ChartLabels };
    const dated = raw.points.map((point) => ({ ...point, t: new Date(`${point.date}T12:00:00`).getTime() }));
    const data: WeightPoint[] = dated.map((point) => {
      const window = dated.filter((item) => item.t >= point.t - (6 * DAY) && item.t <= point.t);
      return { ...point, trend: window.reduce((sum, item) => sum + item.kg, 0) / window.length };
    });
    if (!data.length) return;
    const { labels } = raw;
    const heightCm = Number(root.dataset.height);
    const margin = { top: 32, right: 34, bottom: 68, left: 68 };
    const width = 1000 - margin.left - margin.right;
    const height = 520 - margin.top - margin.bottom;
    const minT = data[0].t;
    const maxT = data.at(-1)!.t;
    const minW = Math.floor(Math.min(...data.map(({ kg }) => kg))) - 1;
    const maxW = Math.ceil(Math.max(...data.map(({ kg }) => kg))) + 1;
    const x = (t: number) => margin.left + ((t - minT) / (maxT - minT)) * width;
    const y = (weight: number) => margin.top + ((maxW - weight) / (maxW - minW)) * height;
    const pathFor = (accessor: (point: WeightPoint) => number) => data.map((point, index) => `${index ? "L" : "M"}${x(point.t)},${y(accessor(point))}`).join(" ");
    const grid = svg.querySelector<SVGGElement>(".chart-grid");
    const paths = svg.querySelector<SVGGElement>(".chart-paths");
    const pointsGroup = svg.querySelector<SVGGElement>(".chart-points");
    const cursor = svg.querySelector<SVGGElement>(".chart-cursor");
    const axis = svg.querySelector<SVGGElement>(".chart-axis");
    const goal = svg.querySelector<SVGGElement>(".chart-goal");
    if (!grid || !paths || !pointsGroup || !cursor || !axis || !goal) return;

    const yTicks = Array.from({ length: Math.floor((maxW - minW) / 5) + 1 }, (_, index) => minW + (index * 5));
    if (yTicks.at(-1) !== maxW) yTicks.push(maxW);
    yTicks.forEach((value) => {
      grid.append(svgEl("line", { x1: margin.left, x2: 1000 - margin.right, y1: y(value), y2: y(value) }));
      const label = svgEl("text", { x: margin.left - 18, y: y(value) + 5, "text-anchor": "end" });
      label.textContent = `${value}`; axis.append(label);
    });
    const bmi25Weight = 25 * Math.pow(heightCm / 100, 2);
    goal.append(svgEl("line", { x1: margin.left, x2: 1000 - margin.right, y1: y(bmi25Weight), y2: y(bmi25Weight), class: "goal-line" }));
    const goalLabel = svgEl("text", { x: 1000 - margin.right, y: y(bmi25Weight) - 12, "text-anchor": "end", class: "goal-label" });
    goalLabel.textContent = `${labels.goal} · ${bmi25Weight.toFixed(1)} kg`; goal.append(goalLabel);
    paths.append(svgEl("path", { d: pathFor(({ kg }) => kg), class: "weight-line" }));
    paths.append(svgEl("path", { d: pathFor(({ trend }) => trend), class: "trend-line" }));

    const summerLow = data.find(({ kind }) => kind === "summer-low");
    const summerHigh = data.find(({ kind }) => kind === "summer-high");
    if (summerLow && summerHigh) {
      paths.append(svgEl("path", { d: `M${x(summerLow.t)},${y(summerLow.kg)} L${x(summerHigh.t)},${y(summerHigh.kg)}`, class: "rebound-line" }));
      const callout = svgEl("text", { x: (x(summerLow.t) + x(summerHigh.t)) / 2, y: y(summerHigh.kg) - 25, "text-anchor": "middle", class: "rebound-label" });
      callout.textContent = `+4.2 kg · ${labels.summer}`; axis.append(callout);
    }
    const locale = root.dataset.lang === "pl" ? "pl-PL" : "en-GB";
    const formatDate = (point: WeightPoint) => new Intl.DateTimeFormat(locale, { day: "numeric", month: "short", year: "numeric" }).format(new Date(`${point.date}T12:00:00`));
    const specialKinds = new Set(["start", "milestone-105", "milestone-100", "milestone-95", "summer-low", "summer-high", "bmi-crossing", "minimum", "current"]);
    data.forEach((point) => {
      const special = specialKinds.has(point.kind);
      const group = svgEl("g", { class: `data-point data-point--${special ? point.kind : "measurement"}` });
      group.append(svgEl("circle", { cx: x(point.t), cy: y(point.kg), r: point.kind === "start" || point.kind === "current" ? 8 : special ? 6 : 2.1, class: "point-dot" }));
      pointsGroup.append(group);
    });

    const cursorLine = svgEl("line", { y1: margin.top, y2: margin.top + height, class: "chart-cursor-line" });
    const cursorDot = svgEl("circle", { r: 8, class: "chart-cursor-dot" });
    cursor.append(cursorLine, cursorDot);
    let activeIndex = data.length - 1;
    const showPoint = (index: number) => {
      activeIndex = Math.max(0, Math.min(data.length - 1, index));
      const point = data[activeIndex]; const px = x(point.t); const py = y(point.kg);
      cursorLine.setAttribute("x1", String(px)); cursorLine.setAttribute("x2", String(px));
      cursorDot.setAttribute("cx", String(px)); cursorDot.setAttribute("cy", String(py));
      const bmi = point.kg / Math.pow(heightCm / 100, 2);
      tooltip.innerHTML = `<strong>${formatDate(point)}</strong><span>${labels.weight}: ${point.kg.toFixed(1)} kg</span><span>${labels.bmi}: ${bmi.toFixed(1)}</span>`;
      tooltip.style.left = `${Math.min(84, Math.max(16, (px / 1000) * 100))}%`;
      tooltip.style.top = `${Math.max(10, (py / 520) * 100 - 2)}%`;
      tooltip.classList.add("is-visible");
    };
    const indexFromClientX = (clientX: number) => {
      const box = svg.getBoundingClientRect(); const svgX = ((clientX - box.left) / box.width) * 1000;
      return data.reduce((best, point, index) => Math.abs(x(point.t) - svgX) < Math.abs(x(data[best].t) - svgX) ? index : best, 0);
    };
    svg.addEventListener("pointermove", (event) => showPoint(indexFromClientX(event.clientX)));
    svg.addEventListener("pointerdown", (event) => showPoint(indexFromClientX(event.clientX)));
    svg.addEventListener("focus", () => showPoint(activeIndex));
    svg.addEventListener("blur", () => tooltip.classList.remove("is-visible"));
    svg.addEventListener("keydown", (event) => {
      if (["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) event.preventDefault();
      if (event.key === "ArrowLeft") showPoint(activeIndex - 1);
      if (event.key === "ArrowRight") showPoint(activeIndex + 1);
      if (event.key === "Home") showPoint(0);
      if (event.key === "End") showPoint(data.length - 1);
    });

    ["start", "milestone-100", "milestone-95", "current"].forEach((kind, index, kinds) => {
      const point = data.find((item) => item.kind === kind); if (!point) return;
      const label = svgEl("text", { x: x(point.t), y: y(point.kg) + (index % 2 ? 30 : -18), "text-anchor": index === 0 ? "start" : index === kinds.length - 1 ? "end" : "middle", class: "point-label" });
      label.textContent = `${point.kg.toFixed(1)} kg`; axis.append(label);
    });
    const nearest = (date: string) => data.reduce((best, point) => {
      const target = new Date(`${date}T12:00:00`).getTime(); return Math.abs(point.t - target) < Math.abs(best.t - target) ? point : best;
    });
    const tickPoints = [data[0], nearest("2026-02-01"), nearest("2026-04-01"), nearest("2026-06-01"), nearest("2026-08-01"), nearest("2026-10-01"), data.at(-1)!]
      .filter((point, index, all) => all.findIndex((item) => item.date === point.date) === index);
    tickPoints.forEach((point, index) => {
      const label = svgEl("text", { x: x(point.t), y: 505, "text-anchor": index === 0 ? "start" : index === tickPoints.length - 1 ? "end" : "middle", class: "date-label" });
      label.textContent = new Intl.DateTimeFormat(locale, { month: "short", year: "2-digit" }).format(new Date(`${point.date}T12:00:00`)); axis.append(label);
    });
  });
</script>
