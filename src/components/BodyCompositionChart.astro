---
import journey from "../../public/data/journey-2025-2026.json";

interface Props { lang: "pl" | "en"; }
const { lang } = Astro.props;
const locale = lang === "pl" ? "pl-PL" : "en-GB";
const waist = journey.stageTwo.waist;
const bodyFat = journey.stageTwo.bodyFat;
const allDates = [...waist, ...bodyFat].map(({ date }) => new Date(`${date}T12:00:00`).getTime());
const start = Math.min(...allDates);
const end = Math.max(...allDates);
const width = 1000;
const plotLeft = 94;
const plotRight = 962;
const plotWidth = plotRight - plotLeft;
const range = Math.max(end - start, 1);
const xTime = (timestamp: number) => plotLeft + ((timestamp - start) / range) * plotWidth;
const x = (date: string) => xTime(new Date(`${date}T12:00:00`).getTime());
const scaleY = (value: number, min: number, max: number, top: number, bottom: number) => top + ((max - value) / (max - min)) * (bottom - top);
const domain = (values: number[], step: number, padding: number) => {
  const min = Math.floor((Math.min(...values) - padding) / step) * step;
  const max = Math.ceil((Math.max(...values) + padding) / step) * step;
  return { min, max: Math.max(max, min + step) };
};
const fatDomain = domain(bodyFat.map(({ pct }) => pct), .5, .3);
const waistDomain = domain(waist.map(({ cm }) => cm), 2, 1);
const axisTicks = (min: number, max: number, count: number) =>
  Array.from({ length: count }, (_, index) => min + ((max - min) * index) / (count - 1));
const fatTicks = axisTicks(fatDomain.min, fatDomain.max, 4);
const waistTicks = axisTicks(waistDomain.min, waistDomain.max, 4);
const path = <T,>(entries: T[], getDate: (entry: T) => string, getValue: (entry: T) => number, min: number, max: number, top: number, bottom: number) =>
  entries.map((entry, index) => `${index ? "L" : "M"}${x(getDate(entry)).toFixed(1)},${scaleY(getValue(entry), min, max, top, bottom).toFixed(1)}`).join(" ");
const fatPath = path(bodyFat, (entry) => entry.date, (entry) => entry.pct, fatDomain.min, fatDomain.max, 72, 206);
const waistPath = path(waist, (entry) => entry.date, (entry) => entry.cm, waistDomain.min, waistDomain.max, 284, 418);
const formatDate = (date: string | number) => new Intl.DateTimeFormat(locale, { day: "numeric", month: "short" }).format(typeof date === "number" ? new Date(date) : new Date(`${date}T12:00:00`));
const formatDecimal = (value: number) => new Intl.NumberFormat(locale, { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(value);
const formatWhole = (value: number) => new Intl.NumberFormat(locale, { maximumFractionDigits: 0 }).format(value);
const ticks = axisTicks(start, end, 4).map((timestamp, index, entries) => ({
  timestamp,
  anchor: index === 0 ? "start" : index === entries.length - 1 ? "end" : "middle",
}));
const copy = lang === "pl" ? {
  eyebrow: "Punkt odniesienia przed etapem 2 · 2026",
  title: "Skład ciała, pomiar po pomiarze",
  desc: "Pomiary od września do listopada 2026, zebrane jeszcze w etapie 1. To punkt odniesienia przed 1 grudnia, nie wyniki drugiego etapu. Każdy zapis ma swoją rzeczywistą datę.",
  fat: "Tkanka tłuszczowa",
  waist: "Obwód pasa",
  fatChange: `${formatDecimal(bodyFat[0].pct)} → ${formatDecimal(bodyFat.at(-1)!.pct)}%`,
  waistChange: `${formatWhole(waist[0].cm)} → ${formatWhole(waist.at(-1)!.cm)} cm`,
  scroll: "Przewijany wykres składu ciała. Użyj strzałek lub gestu przesunięcia, aby zobaczyć całą oś czasu.",
  note: `${bodyFat.length} zapisów tłuszczu i ${waist.length} pomiarów pasa. Pomiary nie zawsze wypadały tego samego dnia; przerwy na osi są prawdziwe.`,
} : {
  eyebrow: "Pre-stage-two baseline · 2026",
  title: "Body composition, reading by reading",
  desc: "Readings from September to November 2026, collected during stage one. A reference before December 1st, not stage-two results. Every entry appears on its actual date.",
  fat: "Body fat",
  waist: "Waist",
  fatChange: `${formatDecimal(bodyFat[0].pct)} → ${formatDecimal(bodyFat.at(-1)!.pct)}%`,
  waistChange: `${formatWhole(waist[0].cm)} → ${formatWhole(waist.at(-1)!.cm)} cm`,
  scroll: "Scrollable body-composition chart. Use arrow keys or swipe to explore the full timeline.",
  note: `${bodyFat.length} body-fat readings and ${waist.length} waist measurements. They were not always taken on the same day; the gaps on the axis are real.`,
};
---

<figure class="composition-chart">
  <figcaption class="composition-heading">
    <div>
      <span class="eyebrow">{copy.eyebrow}</span>
      <h3>{copy.title}</h3>
      <p>{copy.desc}</p>
    </div>
    <div class="composition-summary" aria-hidden="true">
      <div><span>{copy.fat}</span><strong>{copy.fatChange}</strong></div>
      <div><span>{copy.waist}</span><strong>{copy.waistChange}</strong></div>
    </div>
  </figcaption>
  <div class="composition-stage">
    <svg viewBox={`0 0 ${width} 475`} role="img" aria-labelledby="composition-title composition-desc">
      <title id="composition-title">{copy.title}</title>
      <desc id="composition-desc">{copy.desc}</desc>
      <g class="composition-grid" aria-hidden="true">
        {fatTicks.map((value) => <><line x1={plotLeft} x2={plotRight} y1={scaleY(value, fatDomain.min, fatDomain.max, 72, 206)} y2={scaleY(value, fatDomain.min, fatDomain.max, 72, 206)} /><text x={plotLeft - 18} y={scaleY(value, fatDomain.min, fatDomain.max, 72, 206) + 5} text-anchor="end">{formatDecimal(value)}%</text></>)}
        {waistTicks.map((value) => <><line x1={plotLeft} x2={plotRight} y1={scaleY(value, waistDomain.min, waistDomain.max, 284, 418)} y2={scaleY(value, waistDomain.min, waistDomain.max, 284, 418)} /><text x={plotLeft - 18} y={scaleY(value, waistDomain.min, waistDomain.max, 284, 418) + 5} text-anchor="end">{formatWhole(value)}</text></>)}
      </g>
      <text class="composition-panel-label" x={plotLeft} y="45">{copy.fat}</text>
      <text class="composition-panel-label" x={plotLeft} y="257">{copy.waist}</text>
      <path class="composition-path composition-path--fat" d={fatPath} />
      <path class="composition-path composition-path--waist" d={waistPath} />
      <g class="composition-dots composition-dots--fat">
        {bodyFat.map((entry) => <circle cx={x(entry.date)} cy={scaleY(entry.pct, fatDomain.min, fatDomain.max, 72, 206)} r="3.2"><title>{formatDate(entry.date)} · {formatDecimal(entry.pct)}%</title></circle>)}
      </g>
      <g class="composition-dots composition-dots--waist">
        {waist.map((entry) => <circle cx={x(entry.date)} cy={scaleY(entry.cm, waistDomain.min, waistDomain.max, 284, 418)} r="4.6"><title>{formatDate(entry.date)} · {formatDecimal(entry.cm)} cm</title></circle>)}
      </g>
      <g class="composition-end-labels" aria-hidden="true">
        <text x={plotRight} y={scaleY(bodyFat.at(-1)!.pct, fatDomain.min, fatDomain.max, 72, 206) - 13} text-anchor="end">{formatDecimal(bodyFat.at(-1)!.pct)}%</text>
        <text x={plotRight} y={scaleY(waist.at(-1)!.cm, waistDomain.min, waistDomain.max, 284, 418) - 13} text-anchor="end">{formatWhole(waist.at(-1)!.cm)} cm</text>
      </g>
      <g class="composition-dates" aria-hidden="true">
        {ticks.map((tick) => <text x={xTime(tick.timestamp)} y="462" text-anchor={tick.anchor}>{formatDate(tick.timestamp)}</text>)}
      </g>
    </svg>
  </div>
  <p class="composition-note">{copy.note}</p>
</figure>

<script>
  import { responsiveChart } from "../lib/responsive-chart";
  document.querySelectorAll<SVGSVGElement>(".composition-stage svg").forEach(svg => responsiveChart(svg, 94, 962, 70));
</script>
